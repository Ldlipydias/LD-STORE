# .env.example

# Stripe (Pagamentos)
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Notificações Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ImgBB (Upload de Imagens)
VITE_IMGBB_API_KEY=

# E-mail (SMTP - Gmail)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_NAME=LD STORE

# Firebase (Configuração do Banco de Dados)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
